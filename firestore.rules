rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque joueur (auth anonyme) ne lit et n'écrit que son propre profil.
    match /players/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Classement du mode infini : lisible par tous les joueurs connectés, chacun n'écrit que sa ligne,
    // et seulement pour améliorer son record (étage entier raisonnable, pseudo court).
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.depth is int && request.resource.data.depth >= 1 && request.resource.data.depth <= 500
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && (resource == null || request.resource.data.depth >= resource.data.depth);
    }
  }
}
